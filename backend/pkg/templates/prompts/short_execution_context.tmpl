<execution_context>
{{if .Task}}
<global_task>
{{.Task.Input}}
</global_task>
{{end}}

<previous_tasks>
{{if .Tasks}}
{{range .Tasks}}- [{{.ID}}] {{.Title}} ({{.Status}})
{{end}}
{{else}}No previous tasks. Refer to the global task above.
{{end}}
</previous_tasks>

<completed_subtasks>
{{if .CompletedSubtasks}}
{{range .CompletedSubtasks}}- [{{.ID}}] {{.Title}} ({{.Status}})
{{end}}
{{else}}No completed subtasks yet — this is the first subtask in the backlog.
{{end}}
</completed_subtasks>

{{if .Subtask}}
<current_subtask>
[{{.Subtask.ID}}] {{.Subtask.Title}}
{{.Subtask.Description}}
</current_subtask>
{{else}}
No current subtask in progress. Refer to planned subtasks below and completed above.
{{end}}

<planned_subtasks>
{{if .PlannedSubtasks}}
{{range .PlannedSubtasks}}- [{{.ID}}] {{.Title}}
{{end}}
{{else}}No planned subtasks remaining. All subtasks completed{{if .Subtask}} except the current one{{end}}.
{{end}}
</planned_subtasks>
</execution_context>

